--!strict
--!native
local configuration = require '@openmw-config'
local fs = require '@dream/fs'
local test = require '@jess/test'
local user = require '@openmw-config/user'

--- The text of the file at `path`, raising the read's own message when there is none.
local function readText(path: string): string
  local text, problem = fs.readFileString(path)
  if not text then error(problem, 0) end

  return text
end


local expect = test.expect
local suite = test.new()
local scratch = assert(rawget(_G, 'scratchRoot') :: string?, 'the suite needs a host-owned scratchRoot')

local function io<Value>(value: Value?, message: string?, kind: dream_fs_ErrorKind?): Value
  if not value then error(message or tostring(kind), 0) end

  return value
end

local function fixture(name: string, source: string): (string, string)
  local directory = fs.join(scratch, 'openmw-config', name)
  io(fs.mkdir(directory, { recursive = true }))
  local path = fs.join(directory, 'openmw.cfg')
  io(fs.writeFile(path, source))
  return directory, path
end

local function read(path: string): string return io(readText(path)) end

suite.describe('configuration ownership', function()
  suite.it('preserves untouched user bytes without creating configured directories', function()
    local source = '# untouched\r\n  encoding = win1252\r\nconfig="missing/user"\r\n'
    local directory, path = fixture('inspect', source)
    local config = configuration.new(path)
    expect(config:renderUser()).toBe ''
    expect(config:last('encoding')).toBe 'win1252'
    expect((fs.exists(fs.join(directory, 'missing/user')))).toBe(false)
    expect(read(path)).toBe(source)
    expect(config:chain()[2].status).toBe 'skippedMissing'

    local _, standalone = fixture('untouched', (source:gsub('config="missing/user"\r\n', '')))
    expect(configuration.new(standalone):renderUser()).toBe(read(standalone))
  end)

  suite.it('loads depth first and retains traversal history after replace=config', function()
    local directory, path = fixture('chain', 'content=Root.esm\nconfig=a\nconfig=b\n')
    io(fs.mkdir(fs.join(directory, 'a/c'), { recursive = true }))
    io(fs.mkdir(fs.join(directory, 'b'), { recursive = true }))
    io(fs.writeFile(fs.join(directory, 'a/openmw.cfg'), 'content=A.esp\nconfig=c\n'))
    io(fs.writeFile(fs.join(directory, 'a/c/openmw.cfg'), 'content=C.esp\n'))
    io(fs.writeFile(fs.join(directory, 'b/openmw.cfg'), 'replace=config\ncontent=B.esp\n'))
    local config = configuration.new(path)
    expect(config:values('content')).toEqual { 'Root.esm', 'B.esp' }
    expect(#config:chain()).toBe(4)
    expect(config:userFile()).toBe(fs.join(directory, 'b/openmw.cfg'))
  end)

  suite.it('persists inherited removal without touching the parent', function()
    local source = '# parent\ncontent=Keep.esm\ncontent=Remove.esp\nconfig=user\n'
    local directory, path = fixture('removal', source)
    io(fs.mkdir(fs.join(directory, 'user'), { recursive = true }))
    local user = fs.join(directory, 'user/openmw.cfg')
    io(fs.writeFile(user, '# user\ncontent=Mine.esp\n# trailer\n'))
    local config = configuration.new(path)
    expect(config:remove('content', 'Remove.esp')).toBe(true)
    expect(config:renderUser()).toBe 'replace=content\ncontent=Keep.esm\n# user\ncontent=Mine.esp\n# trailer\n'
    config:saveUser()
    expect(read(path)).toBe(source)
    expect(configuration.new(path):values('content')).toEqual { 'Keep.esm', 'Mine.esp' }
  end)

  suite.it('relocates inherited relative directories by provenance, not value equality', function()
    local directory, path = fixture('relative-data', 'data=first\ndata=second\nresources=resources\ndata-local=second\nconfig=user\n')
    io(fs.mkdir(fs.join(directory, 'user'), { recursive = true }))
    io(fs.writeFile(fs.join(directory, 'user/openmw.cfg'), ''))
    local config = configuration.new(path)
    expect(#config:dataDirectories()).toBe(4)
    config:remove('data', 'first')
    config:saveUser()
    local reloaded = configuration.new(path)
    expect(reloaded:values('data')).toEqual { fs.join(directory, 'second') }
    expect(#reloaded:dataDirectories()).toBe(3)
    expect(reloaded:dataDirectories()[2]).toBe(reloaded:dataDirectories()[3])
  end)

  suite.it('validates complete replacements before changing state', function()
    local directory = fixture('transactional', '')
    local config = configuration.newEmpty(directory)
    config:append('content', 'Keep.esm')
    local before = config:generation()
    expect(function() config:replace('content', { 'New.esp', 'New.esp' }) end).toThrow 'duplicate content'
    expect(function() config:replace('fallback', { 'Valid,1', 'not-a-pair' }) end).toThrow 'fallback needs'
    expect(function() config:append('content', 'injected\nconfig=elsewhere') end).toThrow 'one key=value line'
    expect(function() config:append('#hidden', 'value') end).toThrow 'one key=value line'
    expect(config:values('content')).toEqual { 'Keep.esm' }
    expect(config:generation()).toBe(before)
  end)

  suite.it('refuses to overwrite an unmodeled sibling of a custom config', function()
    local directory, user = fixture('custom-save', 'content=Valuable.esm\n')
    local custom = fs.join(directory, 'custom.cfg')
    io(fs.writeFile(custom, 'content=Custom.esm\n'))
    local config = configuration.new(custom)
    config:append('content', 'New.esp')
    expect(function() config:saveUser() end).toThrow 'unmodeled user file'
    expect(read(user)).toBe 'content=Valuable.esm\n'
    expect(read(custom)).toBe 'content=Custom.esm\n'
    io(fs.remove(user))
    expect(function() configuration.new(custom):saveUser() end).toThrow 'unmodeled user file'
    expect((fs.exists(user))).toBe(false)
  end)

  suite.it('detects external changes and advances its baseline after successful saves', function()
    local source = 'content=Base.esm\n'
    local directory, path = fixture('save-conflict', source)
    local config = configuration.new(path)
    io(fs.writeFile(path, 'content=External.esm\n'))
    expect(function() config:saveUser({ backup = true }) end).toThrow 'changed since it was loaded'
    expect(read(path)).toBe 'content=External.esm\n'
    expect((fs.exists(path .. '.bak'))).toBe(false)
    io(fs.writeFile(path, source))
    config:append('content', 'First.esp')
    config:saveUser()
    config:append('content', 'Second.esp')
    config:saveUser()
    expect(configuration.new(path):values('content')).toEqual { 'Base.esm', 'First.esp', 'Second.esp' }

    local empty = configuration.newEmpty(fs.join(directory, 'new-user'))
    io(fs.mkdir(fs.join(directory, 'new-user'), { recursive = true }))
    io(fs.writeFile(empty:userFile(), 'content=Appeared.esm\n'))
    expect(function() empty:saveUser() end).toThrow 'changed since it was loaded'
    expect(read(empty:userFile())).toBe 'content=Appeared.esm\n'
  end)

  suite.it('quotes relocated paths with significant whitespace and escape characters', function()
    local directory, path = fixture('quoted-relocation', 'data=remove\ndata="second &&&"name "\nconfig=user\n')
    io(fs.mkdir(fs.join(directory, 'user'), { recursive = true }))
    io(fs.writeFile(fs.join(directory, 'user/openmw.cfg'), ''))
    local config = configuration.new(path)
    config:remove('data', 'remove')
    local expected = config:dataDirectories()
    config:saveUser()
    expect(configuration.new(path):dataDirectories()).toEqual(expected)
    local exported = fs.join(directory, 'export.cfg')
    io(fs.writeFile(exported, config:render(true)))
    expect(configuration.new(exported):dataDirectories()).toEqual(expected)
  end)

  suite.it('requires explicit roots for recognized tokens and creates nothing on failure', function()
    local directory, path = fixture('missing-token', 'config="?userconfig?"\n')
    expect(function() configuration.new(path) end).toThrow "needs an explicit 'userConfig' root"
    expect((fs.exists(fs.join(directory, '?userconfig?')))).toBe(false)
  end)

  suite.it('clears only user singleton overrides, leaving parent definitions intact', function()
    local source = 'resources=parent-resources\nconfig=user\n'
    local directory, path = fixture('singleton-ownership', source)
    io(fs.mkdir(fs.join(directory, 'user'), { recursive = true }))
    io(fs.writeFile(fs.join(directory, 'user/openmw.cfg'), 'resources=user-resources\n'))
    local config = configuration.new(path)
    config:set('resources', nil)
    local parent = config:path('resources')
    config:set('resources', nil)
    expect(config:path('resources')).toBe(parent)
    config:saveUser()
    expect(configuration.new(path):path('resources')).toBe(parent)
    expect(read(path)).toBe(source)
  end)

  suite.it('keeps token roots separate from configured singleton overrides', function()
    local directory, path = fixture('tokens', 'user-data=override\ndata-local="?userdata?\\local"\ndata="?userconfig?/data"\n')
    local tokens: configuration.Tokens = { userData = fs.join(directory, 'default-data'), userConfig = fs.join(directory, 'default-config') }
    local config = configuration.new(path, { tokens = tokens })
    expect(config:path('user-data')).toBe(fs.join(directory, 'override'))
    expect(config:path('data-local')).toBe(fs.join(tokens.userData :: string, 'local'))
    expect(config:dataDirectories()[1]).toBe(fs.join(tokens.userConfig :: string, 'data'))
  end)

  suite.it('removes a directory by any spelling of the folder it resolves to', function()
    local directory, path = fixture('remove-spelling', 'data=mods/first\ndata="mods/second"\ncontent=mods/first\n')
    local config = configuration.new(path)
    expect(config:remove('data', directory .. '/mods/./first/')).toBe(true)
    expect(config:remove('data', fs.join(directory, 'mods', 'third'))).toBe(false)
    expect(config:remove('content', fs.join(directory, 'mods', 'first'))).toBe(false)
    expect(config:values('data')).toEqual { '"mods/second"' }
    expect(config:values('content')).toEqual { 'mods/first' }
    expect(config:generation()).toBe(1)
    expect(config:remove('data', fs.join(directory, 'mods', 'second'))).toBe(true)
    expect(config:dataDirectories()).toEqual {}
  end)

  suite.it('answers its queries with copies a caller may keep and change', function()
    local _, path = fixture('copies', '# head\ncontent=A.esp\ndata=one\ncontent=B.esp\n# tail\n')
    local config = configuration.new(path)
    local entries, chain = config:entries(), config:chain()
    expect(#entries).toBe(4)
    expect(entries[4].key).toBe(nil)
    expect(entries[4].comment).toBe '# tail\n'
    entries[1].value = 'Changed.esp'
    table.remove(entries)
    chain[1].status = 'skippedMissing'
    expect(config:values('content')).toEqual { 'A.esp', 'B.esp' }
    expect(config:values('absent')).toEqual {}
    expect(#config:entries()).toBe(4)
    expect(config:chain()).toEqual { { path = path, depth = 0, status = 'loaded' } }

    -- A key that is no string at all is the key of the comments after the last setting, which
    -- have no value to give.
    local values = (config.values :: unknown) :: (self: configuration.Config, key: unknown) -> { string }
    expect(values(config, nil)).toEqual {}
  end)

  suite.it('resolves relative paths from any explicitly named config file', function()
    local directory = fixture('custom-name', '')
    local custom = fs.join(directory, 'custom.cfg')
    io(fs.writeFile(custom, 'data=relative\n'))
    expect(configuration.new(custom):dataDirectories()).toEqual { fs.join(directory, 'relative') }
  end)

  suite.it('locates the configuration a file or a folder names, under any capitalization', function()
    local directory, path = fixture('located', '')
    expect((configuration.locate(path))).toBe(path)

    local folder = fs.join(scratch, 'located-folder')
    io(fs.mkdir(folder, { recursive = true }))
    io(fs.writeFile(fs.join(folder, 'OpenMW.CFG'), ''))
    expect((configuration.locate(folder))).toBe(fs.join(folder, 'OpenMW.CFG'))

    local found, problem = configuration.locate(`{directory}-missing`)
    expect(found).toBe(nil)
    expect(problem).toBe(`the configuration '{directory}-missing' isn't a file or a folder`)

    local empty = fs.join(scratch, 'located-empty')
    io(fs.mkdir(empty, { recursive = true }))
    found, problem = configuration.locate(empty)
    expect(found).toBe(nil)
    expect(problem).toBe(`the folder '{empty}' has no openmw.cfg`)
  end)

  suite.it('falls back to OPENMW_CONFIG, then to OpenMW\'s own folder, an empty one naming nothing', function()
    local _, path = fixture('fallbacks', '')
    local own = fs.join(scratch, 'fallbacks-own')
    io(fs.mkdir(own, { recursive = true }))
    io(fs.writeFile(fs.join(own, 'openmw.cfg'), ''))

    expect((configuration.locate(nil, { environment = path, own = own }))).toBe(path)
    expect((configuration.locate('', { environment = '', own = own }))).toBe(fs.join(own, 'openmw.cfg'))

    local found, problem = configuration.locate(nil, {})
    expect(found).toBe(nil)
    expect(problem).toBe('no OpenMW configuration was named, and OpenMW\'s own folder is unknown here')

    local bare = fs.join(scratch, 'fallbacks-bare')
    io(fs.mkdir(bare, { recursive = true }))
    found, problem = configuration.locate(nil, { own = bare })
    expect(found).toBe(nil)
    expect(problem).toBe(`no OpenMW configuration was named, and OpenMW's own folder '{bare}' has no openmw.cfg`)
  end)
end)

suite.describe('OpenMW user folders', function()
  local function system(platform: string, variables: { [string]: string }, folders: { [string]: string }): user.System
    return {
      platform = platform,
      env = function(name: string): string? return variables[name] end,
      knownFolder = function(name: 'home' | 'documents'): string? return folders[name] end,
    }
  end

  suite.it('keeps both in Documents\\My Games\\OpenMW on Windows, wherever Documents is', function()
    local documents = fs.join('D:', 'OneDrive', 'Documents')
    local folder = fs.join(documents, 'My Games', 'OpenMW')
    expect(user.folders(system('windows', {}, { documents = documents, home = 'C:' })))
      .toEqual { userConfig = folder, userData = folder }
    expect(user.folders(system('windows', {}, { home = 'C:' }))).toEqual {}
  end)

  suite.it('splits Preferences from Application Support on macOS', function()
    expect(user.folders(system('macos', { XDG_CONFIG_HOME = '/elsewhere' }, { home = '/Users/n' }))).toEqual {
      userConfig = fs.join('/Users/n', 'Library', 'Preferences', 'openmw'),
      userData = fs.join('/Users/n', 'Library', 'Application Support', 'openmw'),
    }
  end)

  suite.it('follows XDG elsewhere, an empty variable counting as unset', function()
    local variables = { XDG_CONFIG_HOME = '/xdg/config', XDG_DATA_HOME = '' }
    expect(user.folders(system('linux', variables, { home = '/home/n' }))).toEqual {
      userConfig = fs.join('/xdg/config', 'openmw'),
      userData = fs.join('/home/n', '.local', 'share', 'openmw'),
    }
    expect(user.folders(system('linux', {}, {}))).toEqual {}
  end)
end)

return suite
